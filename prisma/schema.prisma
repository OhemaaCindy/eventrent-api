// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
 
}

enum OwnerType {
  INDIVIDUAL
  BUSINESS
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthProvider{
  GOOGLE 
  PASSWORD 
  MAGIC_LINK

}
enum FulfillmentType{
 PICKUP
 DELIVERY
 BOTH

}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  LIVE
  PAUSED
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  PAYMENT_PENDING
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DisputeStatus {
  PENDING_RESOLUTION
  RESOLVED
}

enum DepositHoldStatus {
  HELD
  RELEASED
  DISPUTED
  RETAINED
}

enum DisputeResolution {
  REFUND_RENTER
  RETAIN_DEPOSIT
}

enum PayoutStatus {
  PENDING
  PAID
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  authIdentities AuthIdentity[]
  ownerProfile   OwnerProfile?
  bookings       Booking[]
  disputesOpened   Dispute[] @relation("DisputeOpenedBy")
  disputesResolved Dispute[] @relation("DisputeResolvedBy")
  emailVerificationTokens EmailVerificationToken[]
  messages Message[]
  reviews  Review[]
  orders   Order[]
  events   Event[]
}


model AuthIdentity {
  id               String       @id @default(uuid())
  userId           String
  provider         AuthProvider
  providerUserId   String?
  passwordHash     String?
  emailVerified    Boolean      @default(false)

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
}
model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model OwnerProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  type               OwnerType
  businessName       String?
  verificationStatus VerificationStatus  @default(APPROVED)

  user     User      @relation(fields: [userId], references: [id])
  listings Listing[]
  payouts  Payout[]
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  listings Listing[]
}

model Listing {
  id              String          @id @default(uuid())
  ownerId         String
  categoryId      String
  title           String
  location        String
  quantityTotal   Int
  pricePerDay     Decimal         @db.Decimal(10, 2)
  depositAmount   Decimal         @db.Decimal(10, 2)
  fulfillmentType FulfillmentType
  cancellationPolicy CancellationPolicy @default(FLEXIBLE)
  status          ListingStatus   @default(DRAFT)
  createdAt       DateTime        @default(now())
  
  bookings Booking[]
  images       ListingImage[]
  pricingTiers PricingTier[]
  reviews      Review[]

  owner    OwnerProfile @relation(fields: [ownerId], references: [id])
  category Category     @relation(fields: [categoryId], references: [id])
}

model ListingImage {
  id        String @id @default(uuid())
  listingId String
  url       String
  sortOrder Int

  listing Listing @relation(fields: [listingId], references: [id])
}

model PricingTier {
  id          String  @id @default(uuid())
  listingId   String
  minDays     Int
  pricePerDay Decimal @db.Decimal(10, 2)

  listing Listing @relation(fields: [listingId], references: [id])
}

model Booking {
  id          String        @id @default(uuid())
  renterId    String
  listingId   String
  orderId     String?
  eventId     String?
  quantity    Int
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  status      BookingStatus @default(PAYMENT_PENDING)
  totalPrice  Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())

  payment     Payment?
  depositHold DepositHold?
  payout      Payout?
  messages    Message[]
  review      Review?
  renter  User    @relation(fields: [renterId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model Event {
  id        String   @id @default(uuid())
  renterId  String
  name      String
  eventDate DateTime @db.Date
  createdAt DateTime @default(now())

  renter   User      @relation(fields: [renterId], references: [id])
  bookings Booking[]
}

model Order {
  id                String        @id @default(uuid())
  renterId          String
  providerReference String        @unique
  totalAmount       Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())

  renter   User      @relation(fields: [renterId], references: [id])
  bookings Booking[]
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  listingId  String
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  listing  Listing @relation(fields: [listingId], references: [id])
  reviewer User    @relation(fields: [reviewerId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  bookingId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  sender  User    @relation(fields: [senderId], references: [id])
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  providerReference String
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id])
}



model DepositHold {
  id                      String            @id @default(uuid())
  bookingId               String            @unique
  amount                  Decimal           @db.Decimal(10, 2)
  status                  DepositHoldStatus @default(HELD)
  autoReleaseAt           DateTime
  providerReference       String?
  refundReference         String?
  renterConfirmedReturnAt DateTime?

  booking Booking  @relation(fields: [bookingId], references: [id])
  dispute Dispute?
}

model Dispute {
  id             String             @id @default(uuid())
  depositHoldId  String             @unique
  openedById     String
  reason         String
  evidenceUrls   String[]           @default([])
  status         DisputeStatus      @default(PENDING_RESOLUTION)
  resolution     DisputeResolution?
  resolvedById   String?
  resolvedAt     DateTime?

  depositHold DepositHold @relation(fields: [depositHoldId], references: [id])
  openedBy    User        @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  resolvedBy  User?       @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
}

model Payout {
  id               String       @id @default(uuid())
  bookingId        String       @unique
  ownerId          String
  amount           Decimal      @db.Decimal(10, 2)
  commissionAmount Decimal      @db.Decimal(10, 2)
  status           PayoutStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime     @default(now())

  booking Booking      @relation(fields: [bookingId], references: [id])
  owner   OwnerProfile @relation(fields: [ownerId], references: [id])
}

